.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  box-sizing: border-box;
  height: 112rpx;
  padding: 10rpx 0 calc(10rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eef1f3;
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-label {
  color: #7a8794;
  font-size: 20rpx;
  line-height: 1;
}

.tab-item.active .tab-label {
  color: #0f9d7c;
  font-weight: 600;
}

.current-card {
  background: linear-gradient(135deg, #0f9d7c, #0b7f64);
  color: #ffffff;
}

.current-card .card-title,
.current-card .muted {
  color: rgba(255, 255, 255, 0.85);
}

.current-name {
  font-size: 40rpx;
  font-weight: 800;
  margin: 12rpx 0 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17202a;
  margin: 8rpx 4rpx 16rpx;
}

.role-card {
  border: 2rpx solid transparent;
}

.role-card.selected {
  border-color: #0f9d7c;
  background: #f0faf7;
}

.role-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #17202a;
}

.role-desc {
  margin-top: 8rpx;
}

.buy-card .field {
  margin: 24rpx 0;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background: #f6f8f9;
  border-radius: 14rpx;
  padding: 0 24rpx;
}

.method-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.method-btn {
  flex: 1;
  background: #f3f6f7;
  color: #5b6772;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.method-btn.active {
  background: #e8f5f0;
  color: #0f9d7c;
  font-weight: 600;
}

.notice {
  background: #fff4e8;
  color: #f97316;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.buy-btn {
  margin-top: 8rpx;
}

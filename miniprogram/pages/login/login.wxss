.login-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
}

.brand-card {
  text-align: center;
  padding: 40rpx 0 48rpx;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: #0f9d7c;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 40rpx rgba(15, 157, 124, 0.3);
}

.brand-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #17202a;
}

.brand-sub {
  margin-top: 8rpx;
  color: #7a8794;
  font-size: 26rpx;
}

.center-tip {
  text-align: center;
  margin-top: 20rpx;
}

.choice-tip {
  margin: 12rpx 0 28rpx;
}

.choice-btn {
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.code-row {
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  font-size: 24rpx;
  line-height: 80rpx;
}

.notice {
  background: #fff4e8;
  color: #f97316;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

.outline-btn {
  background: #ffffff;
  color: #0f9d7c;
  border: 1rpx solid #cfe9e0;
}

<view class="page">
  <view class="row between head-row">
    <text class="card-title">发件</text>
    <text class="compose-link" bindtap="goCompose">写邮件</text>
  </view>

  <view class="empty" wx:if="{{!loading && messages.length === 0}}">
    暂无已发送邮件
  </view>

  <view
    class="card message-item"
    wx:for="{{messages}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-emailid="{{item.emailId}}"
    bindtap="openMessage"
  >
    <view class="message-subject">{{item.subject}}</view>
    <view class="muted message-from">收件人：{{item.to}}</view>
    <view class="muted message-time">{{item.time}}</view>
  </view>

  <view class="muted load-more" wx:if="{{loadingMore}}">加载更多...</view>
</view>

<view class="page">
  <view class="card filter-card">
    <view class="row between">
      <text class="card-title">收件箱</text>
      <view class="unread-row">
        <text class="muted">仅看未读</text>
        <switch checked="{{unreadOnly}}" bindchange="onUnreadChange" color="#0F9D7C" />
      </view>
    </view>
    <picker
      range="{{emailFilters}}"
      range-key="address"
      value="{{filterIndex}}"
      bindchange="onFilterEmailChange"
    >
      <view class="picker-value">{{activeEmailAddress || '全部邮箱'}}</view>
    </picker>
  </view>

  <view class="row between head-row">
    <text class="card-title">邮件</text>
    <text class="compose-link" bindtap="goCompose">写邮件</text>
  </view>

  <view class="empty" wx:if="{{!loading && messages.length === 0}}">
    暂无邮件
  </view>

  <view
    class="card message-item"
    wx:for="{{messages}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-emailid="{{item.emailId}}"
    bindtap="openMessage"
  >
    <view class="message-subject">
      <text class="unread-dot" wx:if="{{!item.isRead}}"></text>
      <text>{{item.subject}}</text>
    </view>
    <view class="muted message-from">{{item.from || item.emailAddress}}</view>
    <view class="row between">
      <view class="muted message-email">{{item.emailAddress}}</view>
      <view class="muted message-time">{{item.time}}</view>
    </view>
  </view>

  <view class="muted load-more" wx:if="{{loadingMore}}">加载更多...</view>
</view>

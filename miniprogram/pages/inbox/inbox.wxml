<view class="page">
  <view class="card" wx:if="{{selectedEmail}}">
    <view class="row between" bindtap="toggleEmailChoices">
      <view>
        <view class="email-address">{{selectedEmail.address}}</view>
        <view class="muted">共 {{total}} 封邮件</view>
      </view>
      <text class="switch-tip">{{showEmailChoices ? '收起' : '切换'}}</text>
    </view>
    <view class="email-choices" wx:if="{{showEmailChoices}}">
      <view
        class="choice-item"
        wx:for="{{emailChoices}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-address="{{item.address}}"
        bindtap="chooseEmail"
      >{{item.address}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{!selectedEmail}}">
    <view class="empty">还没有选择邮箱</view>
    <button class="btn btn-ghost" bindtap="toggleEmailChoices">选择邮箱</button>
  </view>

  <view class="card email-choices" wx:if="{{!selectedEmail && showEmailChoices}}">
    <view
      class="choice-item"
      wx:for="{{emailChoices}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-address="{{item.address}}"
      bindtap="chooseEmail"
    >{{item.address}}</view>
  </view>

  <view class="row between head-row" wx:if="{{selectedEmail}}">
    <text class="card-title">收件箱</text>
    <text class="compose-link" bindtap="goCompose">写邮件</text>
  </view>

  <view class="empty" wx:if="{{!loading && selectedEmail && messages.length === 0}}">
    暂无邮件
  </view>

  <view
    class="card message-item"
    wx:for="{{messages}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="openMessage"
  >
    <view class="message-subject">{{item.subject}}</view>
    <view class="muted message-from">{{item.from}}</view>
    <view class="muted message-time">{{item.time}}</view>
  </view>
</view>

.filter-card {
  padding: 20rpx 24rpx;
}

.unread-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-value {
  height: 64rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  background: #f6f8f9;
  border-radius: 12rpx;
  color: #17202a;
  font-size: 26rpx;
  line-height: 64rpx;
}

.head-row {
  margin: 20rpx 4rpx 12rpx;
}

.compose-link {
  color: #0f9d7c;
  font-size: 26rpx;
  font-weight: 600;
}

.message-item {
  padding: 20rpx 24rpx;
}

.message-subject {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  background: #f97316;
  border-radius: 50%;
}

.message-from,
.message-email,
.message-time {
  margin-top: 8rpx;
}

.message-email {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.load-more {
  padding: 20rpx 0;
  text-align: center;
}

.message-subject {
  font-size: 36rpx;
  font-weight: 800;
  color: #17202a;
  margin-bottom: 24rpx;
}

.meta-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.meta-value {
  color: #17202a;
  font-size: 26rpx;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.body-card {
  min-height: 320rpx;
  word-break: break-all;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
}

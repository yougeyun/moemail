<view class="page">
  <view class="quota-card">
    <view class="quota-grid">
      <view class="quota-item">
        <text class="quota-num">{{activeEmailCount}}</text>
        <text class="quota-label">当前邮箱</text>
      </view>
      <view class="quota-divider"></view>
      <view class="quota-item">
        <text class="quota-num">{{remainingToCreate === null ? '不限' : remainingToCreate}}</text>
        <text class="quota-label">可创建</text>
      </view>
      <view class="quota-divider"></view>
      <view class="quota-item">
        <text class="quota-num">{{totalLimit === null ? '不限' : totalLimit}}</text>
        <text class="quota-label">总配额</text>
      </view>
    </view>
  </view>

  <view class="card create-card">
    <view class="card-title">创建邮箱</view>
    <view class="form-grid">
      <view class="field">
        <text class="label">前缀</text>
        <input class="input" placeholder="留空随机" value="{{name}}" bindinput="onNameInput" />
      </view>
      <view class="field">
        <text class="label">域名</text>
        <picker range="{{domains}}" value="{{domainIndex}}" bindchange="onDomainChange">
          <view class="picker-value">{{selectedDomain}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">有效期</text>
        <picker range="{{expiryOptions}}" range-key="label" value="{{expiryIndex}}" bindchange="onExpiryChange">
          <view class="picker-value">{{selectedExpiryLabel}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">数量</text>
        <input class="input" type="number" value="{{count}}" bindinput="onCountInput" />
      </view>
    </view>
    <view class="reward-row" wx:if="{{showRewardButton}}">
      <button class="btn reward-btn" loading="{{rewarding}}" disabled="{{rewarding}}" bindtap="watchRewardedVideo">免费领取额度</button>
    </view>
    <button class="btn create-btn" bindtap="createEmail">创建</button>
  </view>

  <view class="section-head">
    <text class="card-title">我的邮箱</text>
    <text class="muted">共 {{total}} 个</text>
  </view>

  <view class="empty" wx:if="{{!loading && emails.length === 0}}">
    还没有邮箱，先在上方创建一个
  </view>

  <view
    class="card email-item"
    wx:for="{{emails}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-address="{{item.address}}"
    bindtap="selectEmail"
  >
    <view class="email-main">
      <view class="email-address">{{item.address}}</view>
      <view class="muted">到期 {{item.expiresText}}</view>
    </view>
    <view class="email-actions">
      <text class="action" catchtap="copyEmail" data-address="{{item.address}}">复制</text>
      <text class="action" catchtap="shareEmail" data-id="{{item.id}}">分享</text>
      <text
        class="action danger"
        wx:if="{{!item.permanent}}"
        catchtap="deleteEmail"
        data-id="{{item.id}}"
      >删除</text>
    </view>
  </view>
</view>

.page {
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
}

.quota-card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #0f9d7c, #0b7f64);
  color: #ffffff;
}

.quota-grid {
  display: flex;
  align-items: center;
}

.quota-item {
  flex: 1;
  text-align: center;
}

.quota-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.quota-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.quota-divider {
  width: 1px;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.25);
}

.create-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.field {
  box-sizing: border-box;
  width: 50%;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  color: #17202a;
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  height: 64rpx;
  padding: 0 16rpx;
  background: #f6f8f9;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.reward-row {
  margin: 0 8rpx 16rpx;
  padding: 16rpx;
  background: #fff4e8;
  border-radius: 12rpx;
}

.reward-tip {
  display: block;
  margin-bottom: 12rpx;
  color: #f97316;
  font-size: 22rpx;
}

.reward-btn {
  background: #f97316;
  font-size: 24rpx;
  line-height: 64rpx;
}

.create-btn {
  margin: 0 8rpx;
  background: #0f9d7c;
  font-size: 28rpx;
  line-height: 76rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 4rpx 12rpx;
}

.email-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.email-main {
  flex: 1;
  min-width: 0;
}

.email-address {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.email-actions {
  display: flex;
  gap: 12rpx;
}

.action {
  padding: 6rpx 14rpx;
  background: #e8f5f0;
  border-radius: 10rpx;
  color: #0f9d7c;
  font-size: 22rpx;
}

.action.danger {
  background: #fdecec;
  color: #e5484d;
}

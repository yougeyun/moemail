.quota-card {
  text-align: center;
  padding: 36rpx 24rpx;
  background: linear-gradient(135deg, #0f9d7c, #0b7f64);
  color: #ffffff;
}

.quota-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.quota-number {
  font-size: 64rpx;
  font-weight: 800;
}

.quota-unit {
  font-size: 30rpx;
  opacity: 0.9;
}

.quota-card .muted {
  color: rgba(255, 255, 255, 0.8);
}

.field {
  margin-bottom: 24rpx;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background: #f6f8f9;
  border-radius: 14rpx;
  padding: 0 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 16rpx;
}

.email-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.email-main {
  flex: 1;
  min-width: 0;
}

.email-address {
  font-size: 30rpx;
  font-weight: 600;
  color: #17202a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.email-actions {
  display: flex;
  gap: 16rpx;
}

.action {
  color: #0f9d7c;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #e8f5f0;
  border-radius: 10rpx;
}

.action.danger {
  color: #e5484d;
  background: #fdecec;
}

<view class="page">
  <view class="card login-card" wx:if="{{!user && !unbound}}">
    <view class="card-title">登录后使用完整功能</view>
    <view class="muted login-tip">登录后可创建邮箱、接收邮件、兑换激活码和发送邮件。</view>
    <button class="btn login-btn" bindtap="goLogin">登录</button>
  </view>

  <view class="card profile-card" wx:if="{{user}}">
    <view class="avatar">
      <image wx:if="{{user.image}}" src="{{user.image}}" class="avatar-img" mode="aspectFill" />
      <text wx:else>{{user.name ? user.name[0] : '邮'}}</text>
    </view>
    <view class="profile-info">
      <view class="profile-name">{{user.name || user.username}}</view>
      <view class="muted">{{user.email || '未绑定邮箱'}}</view>
    </view>
  </view>

  <view class="card stats-card" wx:if="{{user}}">
    <view class="row">
      <view class="stat-item">
        <view class="stat-num">{{emailCount}}</view>
        <view class="muted">邮箱总数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{sendRemaining === null ? '--' : sendRemaining}}</view>
        <view class="muted">可发邮件</view>
      </view>
    </view>
  </view>

  <view class="card reward-card" wx:if="{{showRewardButton}}">
    <view class="card-title">看视频领邮箱额度</view>
    <button class="btn reward-btn" loading="{{rewarding}}" bindtap="watchRewardedVideo">免费领取额度</button>
  </view>

  <view class="card" wx:if="{{user && showSubscribeSwitch}}">
    <view class="row between">
      <view class="subscribe-info">
        <view class="card-title">新邮件提醒</view>
        <view class="muted">开启后收到新邮件时通过微信通知你</view>
      </view>
      <switch checked="{{subscribeEnabled}}" disabled="{{subscribeLoading}}" bindchange="onSubscribeChange" color="#0F9D7C" />
    </view>
  </view>

  <view class="card" wx:if="{{unbound}}">
    <view class="card-title">绑定邮箱</view>
    <view class="muted bind-tip">绑定邮箱后即可使用创建邮箱和发信功能</view>
    <view class="mode-row">
      <button class="mode-btn {{mode === 'bind' ? 'active' : ''}}" data-mode="bind" bindtap="setMode">绑定已有账号</button>
      <button class="mode-btn {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="setMode">注册新账号</button>
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" type="text" placeholder="请输入邮箱" value="{{email}}" bindinput="onEmailInput" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="{{mode === 'bind' ? '请输入原账号密码' : '请设置密码'}}" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="field">
      <text class="label">验证码</text>
      <view class="row code-row">
        <input class="input code-input" type="text" placeholder="6位验证码" value="{{code}}" bindinput="onCodeInput" />
        <button class="btn btn-ghost code-btn" loading="{{sendingCode}}" bindtap="sendCode">发送验证码</button>
      </view>
    </view>
    <view class="notice" wx:if="{{notice}}">{{notice}}</view>
    <button class="btn submit-btn" loading="{{submitting}}" bindtap="submit">
      {{mode === 'bind' ? '绑定并登录' : '注册并登录'}}
    </button>
  </view>

  <view class="card" wx:if="{{user}}">
    <view class="card-title">激活码兑换</view>
    <view class="field code-field">
      <input class="input" type="text" placeholder="输入激活码" value="{{codeText}}" bindinput="onCodeTextInput" />
      <button class="btn btn-ghost redeem-btn" loading="{{redeeming}}" bindtap="redeem">兑换</button>
    </view>
  </view>

  <button class="btn logout-btn" wx:if="{{user}}" bindtap="logout">退出登录</button>
</view>

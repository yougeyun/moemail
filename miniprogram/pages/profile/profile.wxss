.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  border-radius: 50%;
  background: #0f9d7c;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #17202a;
  margin-bottom: 6rpx;
}

.reward-card {
  border: 1rpx solid #ffe3c7;
}

.reward-tip {
  margin: 12rpx 0 20rpx;
  color: #f97316;
}

.reward-btn {
  background: #f97316;
}

.subscribe-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.bind-tip {
  margin: 10rpx 0 24rpx;
}

.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-btn {
  flex: 1;
  background: #f3f6f7;
  color: #5b6772;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.mode-btn.active {
  background: #e8f5f0;
  color: #0f9d7c;
  font-weight: 600;
}

.field {
  margin-bottom: 24rpx;
}

.code-row {
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  font-size: 24rpx;
  line-height: 80rpx;
}

.notice {
  background: #fff4e8;
  color: #f97316;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

.code-field {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.code-field .input {
  flex: 1;
}

.redeem-btn {
  width: 180rpx;
  line-height: 80rpx;
  font-size: 26rpx;
}

.logout-btn {
  background: #ffffff;
  color: #e5484d;
  border: 1rpx solid #f1d3d4;
}
